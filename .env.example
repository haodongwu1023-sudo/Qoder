# 独立服务配置（避免占用常见开发端口，与获客系统彻底隔离）
APP_HOST=127.0.0.1
APP_PORT=8900

# 1. ASR + MT（例如阿里云 DashScope）
DASHSCOPE_API_KEY=
ASR_MODEL=qwen3-asr-flash-realtime
MT_MODEL=qwen-plus

# 2. 音色克隆 & 流式 TTS（例如 MiniMax / 或替换为自建 CosyVoice / FishSpeech）
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_TTS_MODEL=speech-2.8-turbo
DEFAULT_CLONED_VOICE_ID=

# 3. 音频与虚拟声卡配置
AUDIO_SAMPLE_RATE=16000
VIRTUAL_MIC_OUTPUT_DEVICE=BlackHole 2ch

# 4. 可选：如需向外部系统同步翻译字幕/记录，可配置 Webhook（默认留空，完全独立）
OPTIONAL_WEBHOOK_URL=
