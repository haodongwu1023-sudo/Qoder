# EchoBridge Web 独立项目配置
APP_HOST=0.0.0.0
APP_PORT=8910

# 允许跨域访问的前端域名（部署到 Qoder Sites 后填 https://你的站点.qoder.zone，多个用逗号分隔）
WEB_ALLOWED_ORIGINS=*

# 访客未自填 Key 时，使用服务端体验 Key 的单次最长时长（秒，0 表示不限）
WEB_DEMO_MAX_SECONDS=180

# 阿里云百炼 DashScope API Key
DASHSCOPE_API_KEY=
ASR_MODEL=qwen3-asr-flash-realtime
MT_MODEL=qwen-flash

# MiniMax 音色克隆与流式 TTS（可选，用于 10 秒声音复刻）
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_TTS_MODEL=speech-2.8-turbo
DEFAULT_CLONED_VOICE_ID=

# 与原桌面 App 对齐的音频与低延迟参数
AUDIO_SAMPLE_RATE=16000
VAD_SILENCE_MS=400
KEEPALIVE_INTERVAL_MS=100
KEEPALIVE_IDLE_MS=150
